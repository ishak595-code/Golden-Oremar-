rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "ramcofero.yt@gmail.com" ||
        request.auth.token.email == "goldenoremar@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'))
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "ramcofero.yt@gmail.com" ||
        request.auth.token.email == "goldenoremar@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isVendor() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendor';
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    function isValidUser() {
      return hasOnlyAllowedFields(['email', 'role', 'name', 'phone', 'createdAt', 'status', 'joinDate', 'vendor_id']) &&
             request.resource.data.email is string &&
             request.resource.data.role in ['user', 'vendor', 'admin', 'super_admin'] &&
             request.resource.data.createdAt is string;
    }

    function isValidVendor() {
      return request.resource.data.userId is string &&
             request.resource.data.storeName is string &&
             request.resource.data.tcNo is string &&
             request.resource.data.fullName is string &&
             request.resource.data.phone is string &&
             request.resource.data.email is string &&
             request.resource.data.is_verified is bool &&
             request.resource.data.status in ['pending', 'active', 'rejected', 'deleted'] &&
             request.resource.data.balance is number &&
             request.resource.data.createdAt is string &&
             request.resource.data.address is string &&
             request.resource.data.bank_info is string &&
             request.resource.data.is_active is bool &&
             request.resource.data.commission_rate is number;
    }

    function isValidProduct() {
      return request.resource.data.title is string &&
             request.resource.data.price is number &&
             request.resource.data.stock is number &&
             request.resource.data.is_approved is bool &&
             request.resource.data.is_active is bool &&
             request.resource.data.createdAt is string;
    }

    function isValidCart() {
      return request.resource.data.userId is string &&
             request.resource.data.items is list &&
             request.resource.data.updatedAt is string;
    }

    function isValidOrder() {
      return request.resource.data.userId is string &&
             request.resource.data.vendorId is string &&
             request.resource.data.items is list &&
             request.resource.data.totalPrice is number &&
             request.resource.data.status in ['pending', 'payment_pending_escrow', 'shipped', 'delivered', 'completed'] &&
             request.resource.data.createdAt is string;
    }

    function isValidAddress() {
      return request.resource.data.userId is string &&
             request.resource.data.title is string &&
             request.resource.data.city is string &&
             request.resource.data.district is string &&
             request.resource.data.address is string &&
             request.resource.data.is_default is bool;
    }

    function isValidCategory() {
      return request.resource.data.name is string &&
             request.resource.data.is_active is bool &&
             request.resource.data.createdAt is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser() && (request.resource.data.role == 'user' || isSuperAdmin());
      allow update: if (isOwner(userId) && isValidUser() && request.resource.data.role == resource.data.role) || 
                       (isAdmin() && isValidUser() && request.resource.data.role != 'super_admin' && resource.data.role != 'super_admin') || 
                       isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if true; // Public profiles
      allow create: if (isOwner(request.resource.data.userId) && isValidVendor() && request.resource.data.is_verified == false && request.resource.data.status == 'pending' && request.resource.data.balance == 0) || isAdmin();
      allow update: if (isOwner(resource.data.userId) && isValidVendor() && request.resource.data.is_verified == resource.data.is_verified && request.resource.data.status == resource.data.status && request.resource.data.balance == resource.data.balance) || isAdmin();
    }

    match /products/{productId} {
      allow read: if true; // Public products
      allow create: if (isVendor() && isOwner(request.resource.data.vendorId) && isValidProduct() && request.resource.data.is_approved == false) || (isAdmin() && isValidProduct());
      allow update: if (isVendor() && isOwner(resource.data.vendorId) && isValidProduct() && request.resource.data.is_approved == resource.data.is_approved && request.resource.data.is_rejected == resource.data.is_rejected) || isAdmin();
      allow delete: if (isVendor() && isOwner(resource.data.vendorId)) || isAdmin();
    }

    match /carts/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidCart();
      allow delete: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isOwner(resource.data.vendorId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId) && isValidOrder() && request.resource.data.status == 'pending';
      allow update: if (isOwner(resource.data.userId) && isValidOrder() && request.resource.data.status in ['delivered', 'completed']) || 
                       (isOwner(resource.data.vendorId) && isValidOrder() && request.resource.data.status in ['pending', 'payment_pending_escrow', 'shipped', 'cancelled']) ||
                       isAdmin();
    }

    match /addresses/{addressId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidAddress();
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId) && isValidAddress();
      allow delete: if isOwner(resource.data.userId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /productHealthInfo/{infoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /event_reservations/{reservationId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId);
      allow create: if true; // Allow anyone to register for events (or isAuthenticated() if we want only logged in users)
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    match /vendor_applications/{applicationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /staticContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contactInfo/{infoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /messages/{messageId} {
      // Form kullanicilarin logu icin (giris yapmadan da gonderilebilir)
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /system_logs/{logId} {
      allow create: if true; // Otomatik loglama
      allow read, update, delete: if isAdmin();
    }
  }
}
