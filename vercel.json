{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/gizlilik-politikasi",
      "destination": "/gizlilik-politikasi/index.html"
    },
    {
      "source": "/kullanim-sartlari",
      "destination": "/kullanim-sartlari/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
