{
  "name": "golden-oremar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build-budget.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "audit:security": "node scripts/security-contract-audit.mjs",
    "audit:dependencies": "node scripts/dependency-runtime-boundary-audit.mjs",
    "audit:dependency-updates": "node scripts/dependency-update-governance-audit.mjs",
    "audit:owner-governance": "node scripts/product-owner-governance-contract-audit.mjs",
    "audit:release": "node scripts/run-all-audits.mjs",
    "audit:all": "node scripts/run-all-audits.mjs",
    "audit:bundle": "node scripts/check-build-budget.mjs",
    "audit:dynamic": "node scripts/dynamic-data-contract-audit.mjs",
    "audit:startup": "node scripts/startup-performance-audit.mjs",
    "audit:native": "node scripts/mobile-platform-contract-audit.mjs",
    "lint": "tsc --noEmit",
    "quality": "npm run audit:all && npm run lint && npm run build",
    "android:init": "npx cap init \"Golden Oremar\" com.goldenoremar.app --web-dir dist",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@supabase/supabase-js": "2.111.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie": "^0.6.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}