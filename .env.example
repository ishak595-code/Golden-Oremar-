VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Canonical public web origin used when a native Capacitor build shares a product link.
# Example: https://your-domain.example/
# Do not set this to capacitor://localhost or another private/native scheme.
VITE_PUBLIC_APP_ORIGIN=
# Web production callback URL, e.g. https://your-domain.example/?tab=account
VITE_AUTH_REDIRECT_URL=
# Native builds: this exact URL must also be added to Supabase Auth > Additional Redirect URLs.
VITE_NATIVE_AUTH_REDIRECT_URL=com.goldenoremar.app://auth/callback

# Social login buttons remain hidden until the matching provider is truly configured
# in both the external provider console and Supabase Auth > Providers.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_FACEBOOK_AUTH_ENABLED=false

# Native push is deliberately disabled until Android FCM and iOS APNs capabilities are configured.
VITE_NATIVE_PUSH_ENABLED=false
# Use development for APNs sandbox builds, production for release builds.
VITE_PUSH_ENVIRONMENT=production

# Server-only Supabase Edge Function secrets for push-dispatch.
# Never prefix these with VITE_ and never expose them to the browser bundle.
# Configure FCM as one complete credential set:
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_EMAIL=
FCM_PRIVATE_KEY=
# Configure APNs as one complete credential set:
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.goldenoremar.app
